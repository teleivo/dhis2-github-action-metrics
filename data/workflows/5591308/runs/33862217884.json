\n@Transactional method mixing Hibernate and a plain JdbcTemplate took two\nconnections from the same pool and ran its JDBC statements on autocommit,\noutside the transaction, uncovered by a rollback.\n\nThis is why the org unit merge can destroy data: its JDBC deletes of\ndatavalue and dataapproval commit immediately, so a later failure rolls\nback the Hibernate work while the deleted rows stay gone. It is also why\nthe outlier detection SET LOCAL statement_timeout has never applied.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"02e6e951247767028d214d9d1f586d3166b627d0","tree_id":"dc8a37ba6dac8ea12387215d9548a51724b37043","timestamp":"2026-09-04T10:13:33Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/5591308","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/subscriptions"},"name":"dhis2-core","full_name":"dhis2/dhis2-core","description":"DHIS 2 Core. Written in Java. Contains the service layer and Web API.","html_url":"https://github.com