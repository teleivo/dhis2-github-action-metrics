{"id":34841333766,"name":"Run api tests","node_id":"WFR_kwLOA_1uaM8AAAAIHLSQBg","head_branch":"DHIS2-21401-deadline-global","head_sha":"71ef92ccf405e653e159310b92d04e7e1a9c742c","path":".github/workflows/run-api-tests.yml","run_number":52719,"run_attempt":1,"event":"pull_request","display_title":"feat: bound shared Hibernate queries by the request deadline DHIS2-21401","status":"completed","conclusion":"success","workflow_id":5591308,"check_suite_id":94346767911,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAV94FuJw","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/34841333766","pull_requests":[{"id":4525644283,"number":25201,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/25201","head":{"ref":"DHIS2-21401-deadline-global","sha":"71ef92ccf405e653e159310b92d04e7e1a9c742c","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"master","sha":"66fa13b98ea4701f9b46e0949ceffd9e5644dc22","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-09-14T12:03:19Z","updated_at":"2026-09-14T12:15:14Z","run_started_at":"2026-09-14T12:03:19Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/94346767911","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34841333766/rerun","head_commit":{"message":"feat: bound shared Hibernate queries by the request deadline DHIS2-21401\n\ntracker.export.timeout only reached the tracker owned stores: the JDBC ones\nthrough DeadlineAwareJdbcTemplate, and three Hibernate ones that call\nDeadlineQueries explicitly. The metadata an export mapper resolves first, the\nprogram, tracked entity type, org units and attributes, is read through the\nshared Hibernate stores and ran unbounded, so an export could spend its whole\nbudget before its own first query.\n\nMoves Deadline, DeadlineHolder, DeadlineExceededException and DeadlineQueries\nfrom dhis-tracker to dhis-api, and arms the queries HibernateGenericStore\ncreates from the deadline on the thread. dhis-support-hibernate cannot depend\non dhis-tracker, which is why the classes move rather than the hook reaching\nback.\n\nSafe because arming stays request scoped: DeadlineHolder is only set by\nTrackerExportDeadlineInterceptor, and every method is a no-op when no deadline\nis set, so a store serving any other product is untouched.\n\nAdds Deadline.Scope so this holds when a second feature arms a budget of its\nown. The shared hook honours only ALL_QUERIES, which is what tracker export\nsets, so a future tracker.import.timeout cannot silently bound work that was\ndeliberately left alone.\n\nAlso maps a query cancelled by the deadline to 504 in CrudControllerAdvice.\nOnly the stores calling DeadlineQueries.resultList translated it themselves; a\nquery armed by the shared store throws the raw JPA exception, which was handled\nas a PersistenceException and reported as 409.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"71ef92ccf405e653e159310b92d04e7e1a9c742c","tree_id":"725f0e1fcc51a4359b676b97a67eec6d640cc3a6","timestamp":"2026-09-14T12:03:12Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/5591308","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/subscriptions"},"name":"dhis2-core","full_name":"dhis2/dhis2-core","description":"DHIS 2 Core. Written in Java. Contains the service layer and Web API.","html_url":"https://github.com/dhis2/dhis2-core","fork":false,"private":false,"url":"https://api.github.com/repos/dhis2/dhis2-core","archive_url":"https://api.github.com/repos/dhis2/dhis2-core/{archive_format}{/ref}","assignees_url":"https://api.github.com/repos/dhis2/dhis2-core/assignees{/user}","blobs_url":"https://api.github.com/repos/dhis2/dhis2-core/git/blobs{/sha}","branches_url":"https://api.github.com/repos/dhis2/dhis2-core/branches{/branch}","collaborators_url":"https://api.github.com/repos/dhis2/dhis2-core/collaborators{/collaborator}","comments_url":"https://api.github.com/repos/dhis2/dhis2-core/comments{/number}","commits_url":"https://api.github.com/repos/dhis2/dhis2-core/commits{/sha}","compare_url":"https://api.github.com/repos/dhis2/dhis2-core/compare/{base}...{head}","contents_url":"https://api.github.com/repos/dhis2/dhis2-core/contents/{+path}","contributors_url":"https://api.github.com/repos/dhis2/dhis2-core/contributors","deployments_url":"https://api.github.com/repos/dhis2/dhis2-core/deployments","downloads_url":"https://api.github.com/repos/dhis2/dhis2-core/download