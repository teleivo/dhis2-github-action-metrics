{"id":36409850338,"name":"Run api tests","node_id":"WFR_kwLOA_1uaM8AAAAIejI54g","head_branch":"feat/doris-continuous-analytics","head_sha":"a14a6d695eaaac6aa0e58b1e40cae3ea419151c8","path":".github/workflows/run-api-tests.yml","run_number":53170,"run_attempt":1,"event":"pull_request","display_title":"feat: continuous analytics (lastYears=0) support for Doris","status":"completed","conclusion":"cancelled","workflow_id":5591308,"check_suite_id":98583983317,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAW9BA01Q","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/36409850338","pull_requests":[{"id":4050031827,"number":24440,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/24440","head":{"ref":"feat/doris-continuous-analytics","sha":"0f7e8c070bb000929b07dcf9b76b4aece4b1e80b","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"master","sha":"69df2b06f72ee4b9af38ad78ac42c7636bab8158","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-09-28T10:27:48Z","updated_at":"2026-09-28T10:35:44Z","run_started_at":"2026-09-28T10:27:48Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/98583983317","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/36409850338/rerun","head_commit":{"message":"fix: reject continuous updates against non-unique-key or bounded-years Doris tables\n\nAddresses two review comments from Luciano on #24440:\n\n- A main table created before unique-key analytics tables were introduced\n  stays on the duplicate-key model until a full rebuild recreates it, but\n  removeUpdatedData()'s DELETE requires unique-key (Doris only supports\n  DELETE on unique-key/MOW tables). Add AnalyticsTableManager.\n  isReadyForContinuousUpdate(), checked before a continuous run is\n  attempted: it queries SHOW CREATE TABLE and refuses to proceed if the\n  existing main table isn't unique-key, instead of letting the DELETE fail\n  and letting the update continue regardless (removeUpdatedData()'s stage\n  uses FailurePolicy.SKIP_STAGE, so a failure there doesn't abort the job\n  on its own). Also make the abort explicit if removeUpdatedData() fails\n  for any other reason, rather than proceeding to swap.\n\n- A bounded lastYears=1..N update against an existing main table on a\n  continuous-analytics engine (Doris) previously discarded the rebuilt\n  staging data silently, since removeUpdatedData() only runs for the\n  latest-partition (lastYears=0) case and merging without it would leave\n  stale/deleted rows behind. Fail loudly instead: only a full rebuild or\n  lastYears=0 are supported once the main table exists on such an engine;\n  bounded updates are tracked separately as follow-up work.\n\nPostgres is unaffected (no declarative partitioning); ClickHouse is\nunaffected (no continuous analytics support).\n\n🤖 AI Assisted","author":{"name":"Jason Pickering","email":"jason@dhis2.org"},"id":"a14a6d695eaaac6aa0e58b1e40cae3ea419151c8","tree_id":"19912218b570c412095c0102980e4d36361d8bbe","timestamp":"2026-09-28T10:27:34Z","committer":{"name":"Jason Pickering","email":"jason@dhis2.org"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/5591308","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.