stgres treats the string as a number with an\nastronomically large exponent and aborts the cast to double precision,\nfailing the whole partition build.\n\nScope the outlier stats subquery to NUMERIC_TYPES data elements only, since\nz-score/MAD stats are meaningless for text/date/boolean values, and reuse\nthe existing NUMERIC_REGEXP (no scientific notation) as defense-in-depth.","author":{"name":"Jason Pickering","email":"jason@dhis2.org"},"id":"6330f13d4db708de52f1d652dd5273384ff1c468","tree_id":"aa740245576d5c36740feb22e2b793ca0d2dc5dd","timestamp":"2026-10-08T06:05:26Z","committer":{"name":"Jason Pickering","email":"jason@dhis2.org"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/5591308","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/subscriptions"},"name":"dhis2-core","full_name":"dhis2/dhis2-core","description":"DHIS 2 Core. Written in Java. Contains the service layer and Web API.","html_url":"https://github.com/dhis2/dhis2-core","fork":false,"private":false,"url":"https://api.github.com/repos/dhis2/dhis2-core","archive_url":"https://a