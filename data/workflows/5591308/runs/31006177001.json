{"id":31006177001,"name":"Run api tests","node_id":"WFR_kwLOA_1uaM8AAAAHOBy26Q","head_branch":"claude/uganda-17-rowcontext-lateral","head_sha":"ed944c7ea5d4a1ec29ff69faa5ac43bbcb468997","path":".github/workflows/run-api-tests.yml","run_number":51766,"run_attempt":1,"event":"pull_request","display_title":"perf: evaluate the rowContext subqueries once, in one lateral join","status":"completed","conclusion":"success","workflow_id":5591308,"check_suite_id":84092137561,"check_suite_node_id":"CS_kwDOA_1uaM8AAAATlEgwWQ","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/31006177001","created_at":"2026-08-05T12:34:02Z","updated_at":"2026-08-05T12:49:40Z","run_started_at":"2026-08-05T12:34:02Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/84092137561","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/31006177001/rerun","head_commit":{"message":"perf: group the rowContext laterals by subquery shape\n\nEvery data element on a repeatable stage generates the same subquery apart\nfrom the expression it selects, so they can share one lateral join and one\nevaluation of it. The traced 18-dimension enrollment line list emitted 54\ncorrelated subselects, then 18 joins, and now emits one.\n\nThe cost is the planner's, not the executor's: each subquery expands to an\nAppend over every year partition plus the inheritance parent, and planning is\npaid per relation reference. Measured on a fixture built to that shape - 21\npartitions, 192 indexes each - planning falls from 893 ms to 53 ms, and the\nthree variants return byte-identical rows.\n\nAlso rejects a select list with unbalanced parentheses: \" from \" is a token\ninside expressions such as extract(year from x), and splitting on the first\none would emit SQL that does not parse.\n\nCo-Authored-By: Claude Opus 5 \u003cnoreply@anthropic.com\u003e","author":{"name":"Claude","email":"noreply@anthropic.com"},"id":"ed944c7ea5d4a1ec29ff69faa5ac43bbcb468997","tree_id":"67aa7f7165538a1e5f3bf8a1c2da893c79a90ab6","timestamp":"2026-08-05T11:35:18Z","committer":{"name":"Claude","email":"noreply@anthropic.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/5591308","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/subscriptions"},"name":"dhis2-core","full_name":"dhis2/dhis2-core","description":"DHIS 2 Core. Written in Java. Contains the service layer and Web API.","html_url":"https://github.com/dhis2/dhis2-core","fork":false,"private":false,"url":"https://api.github.com/repos/dhis2/dhis2-core","archive_url":"https://api.github.com/repos/dhis2/dhis2-core/{archive_format}{/ref}","as