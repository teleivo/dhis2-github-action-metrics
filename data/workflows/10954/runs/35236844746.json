{"id":35236844746,"name":"Test","node_id":"WFR_kwLOA_1uaM8AAAAINEeUyg","head_branch":"DHIS2-20927-merge-te-queries","head_sha":"36ab2e8807d98ec1a3d8b9c0f69b79f6794df59e","path":".github/workflows/run-tests.yml","run_number":56499,"run_attempt":1,"event":"pull_request","display_title":"perf: merge the tracked entity id and fetch queries DHIS2-20927","status":"completed","conclusion":"success","workflow_id":10954,"check_suite_id":95431082457,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAWOCLB2Q","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/35236844746","pull_requests":[{"id":4559882458,"number":25267,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/25267","head":{"ref":"DHIS2-20927-merge-te-queries","sha":"36ab2e8807d98ec1a3d8b9c0f69b79f6794df59e","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"DHIS2-20927-sequential-te-export","sha":"85d5472f97b75f4d717eec838b0436ea64f213db","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-09-17T14:55:39Z","updated_at":"2026-09-17T15:03:48Z","run_started_at":"2026-09-17T14:55:39Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/95431082457","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/35236844746/rerun","head_commit":{"message":"perf: merge the tracked entity id and fetch queries DHIS2-20927\n\nThe export ran a query to find the page's tracked entity ids, then a second one\nto fetch their columns. The first query already reads trackedentity, so the\nsecond re-reads the same rows by primary key.\n\nThe id query now joins trackedentity, trackedentitytype and organisationunit\nonto its own result and returns hydrated TrackedEntity objects. The join sits\noutside the subquery, so the wide columns stay out of the DISTINCT and are only\nread for the rows being returned. Order-by columns remain in the subquery's\nselect list so the outer ORDER BY can still see them.\n\nThis is not a speed improvement. On warm pooled connections it measures 9.18ms\nas three queries against 9.65ms merged, a slight regression. What it removes is\na round trip and the TrackedEntityIdentifiers indirection, which was already\nmarked deprecated as a temporary solution.\n\nProgram owners are not folded in. Without a program a tracked entity may own in\nseveral programs, so that join would multiply rows; they stay a separate fetch.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"36ab2e8807d98ec1a3d8b9c0f69b79f6794df59e","tree_id":"c6499a3222a4a326081d6f46293b9c9a8efa9e5b","timestamp":"2026-09-17T14:55:22Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","