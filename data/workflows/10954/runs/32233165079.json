{"id":32233165079,"name":"Test","node_id":"WFR_kwLOA_1uaM8AAAAHgT8RFw","head_branch":"psde-projection-41","head_sha":"cd7b24254e7bf9a72d9c9f41a0a56dc48b36b208","path":".github/workflows/run-tests.yml","run_number":55753,"run_attempt":1,"event":"pull_request","display_title":"perf: project program stage data elements in preheat DHIS2-21979 [2.41]","status":"completed","conclusion":"success","workflow_id":10954,"check_suite_id":87377003721,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAUWBNEyQ","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/32233165079","pull_requests":[{"id":4312055067,"number":24907,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/24907","head":{"ref":"psde-projection-41","sha":"72968b7e60997469ad98deb2449210ef30f2a291","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"2.41","sha":"42d08441cb3e7e9d14d6e4f8be5b47661f487025","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-08-19T08:33:13Z","updated_at":"2026-08-19T08:49:25Z","run_started_at":"2026-08-19T08:33:13Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/87377003721","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/32233165079/rerun","head_commit":{"message":"fix: project the data elements event notifications render\n\nPlaceholders resolved against event.getProgramStage().getDataElements(), which\nwalks programStageDataElements. That is one DataElement entity per element of the\nstage to render a handful of placeholders, and it is empty on a preheat mapped\nstage, so notifications from the importer rendered every placeholder as\nDE_NOT_IN_STAGE. Nothing asserted a rendered placeholder through the import path,\nso CI stayed green.\n\nProject what the renderer needs instead, keyed by program stage id and bounded by\nthe placeholders: whether the data element belongs to the stage, and its option\ncodes to names. Restricting to the stage keeps reporting a data element that is\nnot part of it.\n\nThe renderer test builds metadata through Hibernate without flushing, so it\nflushes before rendering now that the fetcher reads with SQL.\n\nAlso corrects why the preheat projection query is unioned. An or does not fail to\nuse an index, both forms scan the stage. It costs a join filter over the paired\nrows plus a sort to deduplicate.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"cd7b24254e7bf9a72d9c9f41a0a56dc48b36b208","tree_id":"b427829da4dcc488efa88f7c27a079ed0d0fc1f2","timestamp":"2026-08-19T08:31:34Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/u