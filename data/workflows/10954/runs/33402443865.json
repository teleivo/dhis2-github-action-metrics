{"id":33402443865,"name":"Test","node_id":"WFR_kwLOA_1uaM8AAAAHxvDYWQ","head_branch":"DHIS2-21390","head_sha":"764c20d183f1774ae5c5a83d3b96eb748768e944","path":".github/workflows/run-tests.yml","run_number":55959,"run_attempt":1,"event":"pull_request","display_title":"feat: bound tracker export requests by a configurable timeout DHIS2-21390","status":"completed","conclusion":"success","workflow_id":10954,"check_suite_id":90507005897,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAVEqNPyQ","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/33402443865","pull_requests":[{"id":4358386747,"number":24970,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/24970","head":{"ref":"DHIS2-21390","sha":"764c20d183f1774ae5c5a83d3b96eb748768e944","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"master","sha":"024cc5449976129bdc88fb6b43889a5313ff4dd8","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-08-31T14:24:30Z","updated_at":"2026-08-31T14:33:56Z","run_started_at":"2026-08-31T14:24:30Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/90507005897","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/33402443865/rerun","head_commit":{"message":"feat: bound tracker change log queries by the export deadline DHIS2-21390\n\nThe change log endpoints are sub paths of the export controllers\n(/api/tracker/{trackedEntities,events,trackerEvents,singleEvents}/{uid}/changeLogs),\nso the interceptor already armed a deadline for them. They read through\nHibernate rather than the deadline aware template, so nothing ever read it and\nthey ran unbounded while tracker.export.timeout claimed to bound them.\n\nExtracts withDeadline/resultList/singleResult out of HibernateRelationshipStore\ninto DeadlineQueries in the timeout package and calls it from the two change log\nread sites: HibernateEventChangeLogStore, which serves all three event variants,\nand HibernateTrackedEntityChangeLogStore. resultList and singleResult now arm and\nrun in one call, so the common case needs a single call instead of a nested pair.\n\nNotes need no change: HibernateNoteStore declares no queries of its own and the\nnote endpoints are import side writes.\n\nKept as one config key. These are interactive reads of the same order of\nmagnitude as the exports they hang off, so a second key would only invite per\nendpoint tuning of what is really one budget protecting the connection pool.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"764c20d183f1774ae5c5a83d3b96eb748768e944","tree_id":"7da0fbbcdf1b7241166fd033aadb15b7f78d692a","timestamp":"2026-08-31T14:20:52Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/