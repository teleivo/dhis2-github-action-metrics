ery\n@Transactional method mixing Hibernate and a plain JdbcTemplate took a\nsecond connection from the same pool which was not enlisted in the\ntransaction: its statements commit immediately and a rollback does not\ncover them.\n\nThis is why the org unit merge can destroy data. Its JDBC deletes of\ndatavalue and dataapproval commit as they run, so a later failure rolls\nback the Hibernate work while the deleted rows stay gone.\n\nIntroduced in 2.41 by 6eb421d7d285dfdec6b17a86b5258df083c7f982 (#14626,\nTECH-1517), which swapped HibernateTransactionManager for\nJpaTransactionManager and dropped its setDataSource call.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"0850192d9db6177e509230184f48ac58e944e5b9","tree_id":"28c739cff67e57fdbae48c1346a2eb1134ac8e8b","timestamp":"2026-09-08T13:25:09Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/subscriptions"},"name":"dhis2-core","full_name":"