{"id":34947047631,"name":"Test","node_id":"WFR_kwLOA_1uaM8AAAAIIwGgzw","head_branch":"DHIS2-21401-deadline-global","head_sha":"1a59a28417622a67e19f966bdaf2645c644246df","path":".github/workflows/run-tests.yml","run_number":56386,"run_attempt":1,"event":"pull_request","display_title":"feat: bound shared Hibernate queries by the request deadline DHIS2-21401","status":"completed","conclusion":"success","workflow_id":10954,"check_suite_id":94632874372,"check_suite_node_id":"CS_kwDOA_1uaM8AAAAWCI8RhA","url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631","html_url":"https://github.com/dhis2/dhis2-core/actions/runs/34947047631","pull_requests":[{"id":4525644283,"number":25201,"url":"https://api.github.com/repos/dhis2/dhis2-core/pulls/25201","head":{"ref":"DHIS2-21401-deadline-global","sha":"b543bfb81137d76d4ff8126e5d0b5152921564aa","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}},"base":{"ref":"master","sha":"e94ba1177d5f86d050e89a220c6fc2b3823d37b7","repo":{"id":66940520,"name":"dhis2-core","url":"https://api.github.com/repos/dhis2/dhis2-core"}}}],"created_at":"2026-09-15T08:27:24Z","updated_at":"2026-09-15T08:36:10Z","run_started_at":"2026-09-15T08:27:24Z","jobs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631/jobs","logs_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631/logs","check_suite_url":"https://api.github.com/repos/dhis2/dhis2-core/check-suites/94632874372","artifacts_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631/artifacts","cancel_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631/cancel","rerun_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/runs/34947047631/rerun","head_commit":{"message":"feat: bound shared Hibernate queries by the request deadline DHIS2-21401\n\ntracker.export.timeout only bounded queries issued by tracker's own stores. A\ntracker export request also triggers queries outside tracker, the metadata it\nresolves first (program, tracked entity type, org units, attributes) through the\nplatform stores every product shares, and those ran unbounded.\n\nHibernateGenericStore now gives every query it creates a timeout taken from the\ndeadline on the thread. A deadline is the remaining time of the request holding\nit, so every query that request issues is bounded by it; a thread with no\ndeadline is unbounded. DeadlineHolder is only set by\nTrackerExportDeadlineInterceptor, so stores serving any other product are\nuntouched.\n\nThe deadline classes move from dhis-tracker to dhis-api because\ndhis-support-hibernate cannot depend on dhis-tracker.\n\nAlso maps a query cancelled by the deadline to 504 in CrudControllerAdvice; it\nwas a PersistenceException reported as 409.\n\nOnly queries created by HibernateGenericStore are covered. Native queries go\nthrough HibernateNativeStore and stay unbounded, as does anything using the\nplain JdbcTemplate. No export path reaches either today. HibernateNativeStore's\nquery factories are shared with write paths, which are out of scope for an\nexport timeout.","author":{"name":"teleivo","email":"teleivo@users.noreply.github.com"},"id":"1a59a28417622a67e19f966bdaf2645c644246df","tree_id":"a000ee59f0c02140494a496db60b19d59dcda617","timestamp":"2026-09-15T08:27:18Z","committer":{"name":"teleivo","email":"teleivo@users.noreply.github.com"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com