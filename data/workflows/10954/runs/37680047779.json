te a full-state User audit entry.\nAPI token requests, and basic auth requests without a session cookie,\ndid this on every request.\n\n- Write lastLogin with a single column update outside the entity\n  lifecycle and evict only that user's L2 entry. lastLogin is mapped\n  update=\"false\" so entity updates cannot write back a stale value.\n- Skip UPDATE audits that only change lastUpdated, lastUpdatedBy,\n  lastLogin or lastCheckedInterpretations and no collection. The\n  update listener now decides at flush time and sends the audit after\n  a successful commit, because in-place collection changes are not part\n  of the dirty properties and are no longer dirty after the commit.","author":{"name":"Morten Svanaes","email":"msvanaes@dhis2.org"},"id":"fd826d426ed4d35c6d99520da9a3093e36bb1245","tree_id":"4ee8d4b37ae6829a18fab452efc31f86326b853b","timestamp":"2026-10-07T20:10:22Z","committer":{"name":"Morten Svanaes","email":"msvanaes@dhis2.org"}},"workflow_url":"https://api.github.com/repos/dhis2/dhis2-core/actions/workflows/10954","repository":{"id":66940520,"node_id":"MDEwOlJlcG9zaXRvcnk2Njk0MDUyMA==","owner":{"login":"dhis2","id":1089987,"node_id":"MDEyOk9yZ2FuaXphdGlvbjEwODk5ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1089987?v=4","html_url":"https://github.com/dhis2","gravatar_id":"","type":"Organization","site_admin":false,"url":"https://api.github.com/users/dhis2","events_url":"https://api.github.com/users/dhis2/events{/privacy}","following_url":"https://api.github.com/users/dhis2/following{/other_user}","followers_url":"https://api.github.com/users/dhis2/followers","gists_url":"https://api.github.com/users/dhis2/gists{/gist_id}","organizations_url":"https://api.github.com/users/dhis2/orgs","received_events_url":"https://api.github.com/users/dhis2/received_events","repos_url":"https://api.github.com/users/dhis2/repos","starred_url":"https://api.github.com/users/dhis2/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dhis2/s